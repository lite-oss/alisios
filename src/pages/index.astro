    </div>
    <div class="contact-links reveal rv2">
      <a href={`mailto:${site.email}`} class="contact-link-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Email
      </a>
      <a href={site.linkedin} target="_blank" class="contact-link-btn">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
        LinkedIn
      </a>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <svg viewBox="0 0 340 85" xmlns="http://www.w3.org/2000/svg" style="height:38px;width:auto;margin-bottom:14px;">
          <defs><linearGradient id="lgft" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#e9cd79"/><stop offset="55%" stop-color="#c8a84b"/><stop offset="100%" stop-color="#997f44"/></linearGradient></defs>
          <text x="4" y="58" font-family="Georgia,serif" font-size="64" font-weight="700" fill="#e8f0f7" letter-spacing="-1"><tspan>PASS</tspan><tspan dx="6">-</tspan></text>
          <text x="220" y="58" font-family="Georgia,serif" font-size="64" font-weight="700" fill="url(#lgft)" letter-spacing="-1">A</text>
          <text x="4" y="76" font-family="Arial,sans-serif" font-size="7" fill="rgba(255,255,255,0.35)" textLength="266" lengthAdjust="spacing">PAN AFRICAN FOR STUDIES AND STRATEGIES ADVISORY</text>
        </svg>
        <p data-i18n="footer_tagline">{es.footer_tagline}</p>
      </div>
      <div class="footer-nav">
        <div class="footer-col">
          <div class="footer-col-title" data-i18n="footer_col1">{es.footer_col1}</div>
          <ul>
            <li><a href="#sobre"    data-i18n="nav_sobre">{es.nav_sobre}</a></li>
            <li><a href="#areas"    data-i18n="footer_areas">{es.footer_areas}</a></li>
            <li><a href="#colabora" data-i18n="nav_colabora">{es.nav_colabora}</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <div class="footer-col-title" data-i18n="footer_col2">{es.footer_col2}</div>
          <ul>
            <li><a href="#" data-i18n="footer_pub">{es.footer_pub}</a></li>
            <li><a href="#" data-i18n="footer_events">{es.footer_events}</a></li>
            <li><a href="#" data-i18n="footer_community">{es.footer_community}</a></li>
            <li><a href="#" data-i18n="footer_sub">{es.footer_sub}</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <div class="footer-col-title" data-i18n="nav_contacto">{es.nav_contacto}</div>
          <ul>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={site.linkedin} target="_blank">LinkedIn</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {site.copyright_year} PASS-A — Pan African for Studies and Strategies Advisory</p>
      <div class="footer-langs">
        <button class="f-lang active" data-lang="es">ES</button>
        <button class="f-lang" data-lang="en">EN</button>
        <button class="f-lang" data-lang="fr">FR</button>
      </div>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ es, en, fr }}>
const i18n = { es, en, fr };

let currentLang = 'es';

function setLang(lang) {
  if (!i18n[lang]) return;
  currentLang = lang;
  const t = i18n[lang];

  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.dataset.i18n;
    if (t[key] !== undefined) el.innerHTML = t[key];
  });

  document.querySelectorAll('[data-i18n-list]').forEach(el => {
    const key = el.dataset.i18nList;
    if (Array.isArray(t[key])) {
      el.innerHTML = t[key].map(item => `<li>${item}</li>`).join('');
    }
  });

  document.documentElement.lang = lang;

  document.querySelectorAll('.lang-btn, .f-lang').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.lang === lang);
  });
}

/* NAV scroll */
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 60));

/* Drawer móvil */
function openDrawer() {
  document.getElementById('drawer').classList.add('open');
  document.getElementById('drawerOv').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeDrawer() {
  document.getElementById('drawer').classList.remove('open');
  document.getElementById('drawerOv').classList.remove('open');
  document.body.style.overflow = '';
}

/* Modales */
function openModal(type) {
  document.getElementById('ov-' + type).classList.add('open');
  document.getElementById('modal-' + type).classList.add('open');
  document.body.style.overflow = 'hidden';
  const first = document.querySelector('#modal-' + type + ' input, #modal-' + type + ' select');
  if (first) setTimeout(() => first.focus(), 350);
}
function closeModal(type) {
  document.getElementById('ov-' + type).classList.remove('open');
  document.getElementById('modal-' + type).classList.remove('open');
  document.body.style.overflow = '';
}
function submitModal(e, type) {
  e.preventDefault();
  document.getElementById('form-' + (type === 'intelectual' ? 'i' : 'a')).style.display = 'none';
  document.getElementById('success-' + type).style.display = 'block';
}
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { closeModal('intelectual'); closeModal('apoyo'); }
});

/* Scroll reveal */
const revealObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); }
  });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

/* Selector de idioma */
document.querySelectorAll('.lang-btn, .f-lang').forEach(btn => {
  btn.addEventListener('click', () => {
    const lang = btn.dataset.lang;
    if (lang) setLang(lang);
  });
});

/* Netlify Identity — redirect al admin tras login */
if (window.netlifyIdentity) {
  window.netlifyIdentity.on('init', user => {
    if (!user) {
      window.netlifyIdentity.on('login', () => {
        document.location.href = '/admin/';
      });
    }
  });
}
</script>

</body>
</html>
