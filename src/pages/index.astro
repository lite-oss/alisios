---
import es from '../_data/lang/es.yaml';
import en from '../_data/lang/en.yaml';
import fr from '../_data/lang/fr.yaml';
import site from '../_data/site.yaml';
---

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PASS-A — Pan African for Studies and Strategies Advisory</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Libre+Franklin:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

<!-- NAV -->
<nav class="nav" id="nav">
  <a href="#" class="nav-logo">
    <svg viewBox="0 0 340 85" xmlns="http://www.w3.org/2000/svg" style="height:42px;width:auto;">
      <defs><linearGradient id="lgnav" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#e9cd79"/><stop offset="55%" stop-color="#c8a84b"/><stop offset="100%" stop-color="#997f44"/></linearGradient></defs>
      <text x="4" y="58" font-family="Georgia,serif" font-size="64" font-weight="700" fill="#e8f0f7" letter-spacing="-1"><tspan>PASS</tspan><tspan dx="6">-</tspan></text>
      <text x="220" y="58" font-family="Georgia,serif" font-size="64" font-weight="700" fill="url(#lgnav)" letter-spacing="-1">A</text>
      <text x="4" y="76" font-family="Arial,sans-serif" font-size="7" fill="rgba(255,255,255,0.4)" textLength="266" lengthAdjust="spacing">PAN AFRICAN FOR STUDIES AND STRATEGIES ADVISORY</text>
    </svg>
  </a>
  <ul class="nav-links">
    <li><a class="nav-link" href="#sobre" data-i18n="nav_sobre">{es.nav_sobre}</a></li>
    <li><a class="nav-link" href="#areas" data-i18n="nav_areas">{es.nav_areas}</a></li>
    <li><a class="nav-link" href="#colabora" data-i18n="nav_colabora">{es.nav_colabora}</a></li>
    <li><a class="nav-link" href="#contacto" data-i18n="nav_contacto">{es.nav_contacto}</a></li>
  </ul>
  <div style="display:flex;align-items:center;gap:16px;">
    <div class="nav-lang">
      <button class="lang-btn active" data-lang="es">ES</button>
      <button class="lang-btn" data-lang="en">EN</button>
      <button class="lang-btn" data-lang="fr">FR</button>
    </div>
    <button class="nav-cta" onclick="openModal('intelectual')">
      <span data-i18n="nav_cta">{es.nav_cta}</span>
    </button>
  </div>
  <div class="hamburger" id="hamburger" onclick="openDrawer()">
    <span></span><span></span><span></span>
  </div>
</nav>

<!-- DRAWER MÓVIL -->
<div class="drawer-ov" id="drawerOv" onclick="closeDrawer()"></div>
<div class="drawer" id="drawer">
  <button class="drawer-x" onclick="closeDrawer()">✕</button>
  <a class="drawer-link" href="#sobre" onclick="closeDrawer()" data-i18n="nav_sobre">{es.nav_sobre}</a>
  <a class="drawer-link" href="#areas" onclick="closeDrawer()" data-i18n="nav_areas">{es.nav_areas}</a>
  <a class="drawer-link" href="#colabora" onclick="closeDrawer()" data-i18n="nav_colabora">{es.nav_colabora}</a>
  <a class="drawer-link" href="#contacto" onclick="closeDrawer()" data-i18n="nav_contacto">{es.nav_contacto}</a>
</div>

<!-- HERO -->
<section class="hero" id="inicio">
  <div class="hero-bg"></div>
  <div class="hero-line"></div>

  <div class="hero-inner hero-inner--split">

    <div class="hero-text">
      <div class="hero-eyebrow" data-i18n="hero_eyebrow">{es.hero_eyebrow}</div>
      <h1 class="hero-title" data-i18n="hero_title" set:html={es.hero_title}></h1>
      <p class="hero-lead" data-i18n="hero_lead">{es.hero_lead}</p>
      <div class="hero-actions">
        <button class="btn-primary" onclick="openModal('intelectual')">
          <span data-i18n="hero_btn1">{es.hero_btn1}</span> <span class="arr">→</span>
        </button>
        <a href="#sobre" class="btn-secondary">
          <span data-i18n="hero_btn2">{es.hero_btn2}</span>
        </a>
      </div>
    </div>

    <div class="hero-illustration" aria-hidden="true">
      <svg viewBox="0 0 520 560" xmlns="http://www.w3.org/2000/svg" class="network-svg">
        <defs>
          <radialGradient id="glow-a" cx="50%" cy="50%" r="50%">
            <stop offset="0%"   stop-color="#e9cd79" stop-opacity="0.35"/>
            <stop offset="100%" stop-color="#e9cd79" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="glow-b" cx="50%" cy="50%" r="50%">
            <stop offset="0%"   stop-color="#c8a84b" stop-opacity="0.25"/>
            <stop offset="100%" stop-color="#c8a84b" stop-opacity="0"/>
          </radialGradient>
          <filter id="blur-soft">
            <feGaussianBlur stdDeviation="3"/>
          </filter>
          <linearGradient id="line-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%"   stop-color="#e9cd79" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="#c8a84b" stop-opacity="0.15"/>
          </linearGradient>
          <linearGradient id="line-grad-2" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%"   stop-color="#c8a84b" stop-opacity="0.5"/>
            <stop offset="100%" stop-color="#e9cd79" stop-opacity="0.1"/>
          </linearGradient>
        </defs>
        <line x1="260" y1="280" x2="110" y2="140" stroke="url(#line-grad)"   stroke-width="1.2" class="net-line"/>
        <line x1="260" y1="280" x2="390" y2="120" stroke="url(#line-grad-2)" stroke-width="1.2" class="net-line"/>
        <line x1="260" y1="280" x2="440" y2="290" stroke="url(#line-grad)"   stroke-width="1.0" class="net-line"/>
        <line x1="260" y1="280" x2="370" y2="430" stroke="url(#line-grad-2)" stroke-width="1.2" class="net-line"/>
        <line x1="260" y1="280" x2="130" y2="400" stroke="url(#line-grad)"   stroke-width="1.0" class="net-line"/>
        <line x1="260" y1="280" x2="80"  y2="290" stroke="url(#line-grad-2)" stroke-width="0.9" class="net-line"/>
        <line x1="260" y1="280" x2="200" y2="80"  stroke="url(#line-grad)"   stroke-width="1.0" class="net-line"/>
        <line x1="260" y1="280" x2="310" y2="490" stroke="url(#line-grad-2)" stroke-width="0.8" class="net-line"/>
        <line x1="110" y1="140" x2="200" y2="80"  stroke="#c8a84b" stroke-width="0.7" stroke-opacity="0.3" class="net-line"/>
        <line x1="200" y1="80"  x2="390" y2="120" stroke="#c8a84b" stroke-width="0.7" stroke-opacity="0.3" class="net-line"/>
        <line x1="390" y1="120" x2="440" y2="290" stroke="#c8a84b" stroke-width="0.7" stroke-opacity="0.25" class="net-line"/>
        <line x1="440" y1="290" x2="370" y2="430" stroke="#c8a84b" stroke-width="0.7" stroke-opacity="0.25" class="net-line"/>
        <line x1="370" y1="430" x2="310" y2="490" stroke="#c8a84b" stroke-width="0.7" stroke-opacity="0.2" class="net-line"/>
        <line x1="130" y1="400" x2="310" y2="490" stroke="#c8a84b" stroke-width="0.7" stroke-opacity="0.2" class="net-line"/>
        <line x1="80"  y1="290" x2="130" y2="400" stroke="#c8a84b" stroke-width="0.7" stroke-opacity="0.25" class="net-line"/>
        <line x1="80"  y1="290" x2="110" y2="140" stroke="#c8a84b" stroke-width="0.7" stroke-opacity="0.2" class="net-line"/>
        <line x1="110" y1="140" x2="60"  y2="190" stroke="#e9cd79" stroke-width="0.5" stroke-opacity="0.2"/>
        <line x1="390" y1="120" x2="460" y2="80"  stroke="#e9cd79" stroke-width="0.5" stroke-opacity="0.2"/>
        <line x1="440" y1="290" x2="500" y2="360" stroke="#e9cd79" stroke-width="0.5" stroke-opacity="0.18"/>
        <line x1="200" y1="80"  x2="260" y2="30"  stroke="#e9cd79" stroke-width="0.5" stroke-opacity="0.2"/>
        <circle cx="260" cy="280" r="52" fill="url(#glow-a)" filter="url(#blur-soft)"/>
        <circle cx="110" cy="140" r="28" fill="url(#glow-b)" filter="url(#blur-soft)"/>
        <circle cx="390" cy="120" r="24" fill="url(#glow-b)" filter="url(#blur-soft)"/>
        <circle cx="440" cy="290" r="22" fill="url(#glow-b)" filter="url(#blur-soft)"/>
        <circle cx="260" cy="280" r="34" fill="none" stroke="#e9cd79" stroke-width="1" stroke-opacity="0.15" class="pulse-ring pulse-ring--1"/>
        <circle cx="260" cy="280" r="34" fill="none" stroke="#e9cd79" stroke-width="1" stroke-opacity="0.1"  class="pulse-ring pulse-ring--2"/>
        <circle cx="260" cy="280" r="18" fill="#081f32" stroke="#e9cd79" stroke-width="1.8"/>
        <circle cx="260" cy="280" r="9"  fill="#e9cd79"/>
        <text x="260" y="313" text-anchor="middle" font-family="Georgia,serif" font-size="9" fill="#e9cd79" fill-opacity="0.7" letter-spacing="2">PASS-A</text>
        <circle cx="110" cy="140" r="13" fill="#081f32" stroke="#c8a84b" stroke-width="1.5" class="net-node"/>
        <circle cx="110" cy="140" r="5.5" fill="#c8a84b" class="net-node"/>
        <circle cx="390" cy="120" r="11" fill="#081f32" stroke="#c8a84b" stroke-width="1.5" class="net-node"/>
        <circle cx="390" cy="120" r="4.5" fill="#c8a84b" class="net-node"/>
        <circle cx="440" cy="290" r="10" fill="#081f32" stroke="#c8a84b" stroke-width="1.2" class="net-node"/>
        <circle cx="440" cy="290" r="4"  fill="#c8a84b" class="net-node"/>
        <circle cx="370" cy="430" r="9"  fill="#081f32" stroke="#c8a84b" stroke-width="1.2" class="net-node"/>
        <circle cx="370" cy="430" r="3.5" fill="#c8a84b" class="net-node"/>
        <circle cx="130" cy="400" r="9"  fill="#081f32" stroke="#c8a84b" stroke-width="1.2" class="net-node"/>
        <circle cx="130" cy="400" r="3.5" fill="#c8a84b" class="net-node"/>
        <circle cx="80"  cy="290" r="7.5" fill="#081f32" stroke="#c8a84b" stroke-width="1.0" class="net-node"/>
        <circle cx="80"  cy="290" r="3"   fill="#c8a84b" class="net-node"/>
        <circle cx="200" cy="80"  r="9"  fill="#081f32" stroke="#c8a84b" stroke-width="1.2" class="net-node"/>
        <circle cx="200" cy="80"  r="3.5" fill="#c8a84b" class="net-node"/>
        <circle cx="310" cy="490" r="7"  fill="#081f32" stroke="#997f44" stroke-width="1.0" class="net-node"/>
        <circle cx="310" cy="490" r="2.8" fill="#997f44" class="net-node"/>
        <circle cx="60"  cy="190" r="4"   fill="#1a4f75" stroke="#c8a84b" stroke-width="0.8" stroke-opacity="0.5"/>
        <circle cx="460" cy="80"  r="3.5" fill="#1a4f75" stroke="#c8a84b" stroke-width="0.8" stroke-opacity="0.5"/>
        <circle cx="500" cy="360" r="3.5" fill="#1a4f75" stroke="#c8a84b" stroke-width="0.8" stroke-opacity="0.4"/>
        <circle cx="260" cy="30"  r="3"   fill="#1a4f75" stroke="#c8a84b" stroke-width="0.8" stroke-opacity="0.4"/>
        <circle r="2.5" fill="#e9cd79" fill-opacity="0.9">
          <animateMotion dur="3.5s" repeatCount="indefinite" begin="0s"><mpath href="#path-central-nw"/></animateMotion>
        </circle>
        <circle r="2" fill="#c8a84b" fill-opacity="0.8">
          <animateMotion dur="4s" repeatCount="indefinite" begin="1.2s"><mpath href="#path-central-ne"/></animateMotion>
        </circle>
        <circle r="2" fill="#e9cd79" fill-opacity="0.7">
          <animateMotion dur="3s" repeatCount="indefinite" begin="0.6s"><mpath href="#path-central-e"/></animateMotion>
        </circle>
        <circle r="1.8" fill="#c8a84b" fill-opacity="0.75">
          <animateMotion dur="4.5s" repeatCount="indefinite" begin="2s"><mpath href="#path-central-sw"/></animateMotion>
        </circle>
        <circle r="1.8" fill="#e9cd79" fill-opacity="0.65">
          <animateMotion dur="3.8s" repeatCount="indefinite" begin="0.3s"><mpath href="#path-central-n"/></animateMotion>
        </circle>
        <path id="path-central-nw" d="M260,280 L110,140" fill="none"/>
        <path id="path-central-ne" d="M260,280 L390,120" fill="none"/>
        <path id="path-central-e"  d="M260,280 L440,290" fill="none"/>
        <path id="path-central-sw" d="M130,400 L260,280" fill="none"/>
        <path id="path-central-n"  d="M200,80  L260,280" fill="none"/>
      </svg>
    </div>

  </div>

  <div class="hero-scroll">
    <span>Descubrir</span>
    <div class="scroll-dot"></div>
  </div>
</section>

<!-- MISSION -->
<section class="mission-strip">
  <blockquote class="mission-quote reveal" data-i18n="mission_quote">{es.mission_quote}</blockquote>
</section>

<!-- ABOUT -->
<section class="about" id="sobre">
  <div class="about-inner">
    <div class="about-content">
      <div class="section-eyebrow reveal" data-i18n="about_eyebrow">{es.about_eyebrow}</div>
      <h2 class="section-title reveal rv1" data-i18n="about_title" set:html={es.about_title}></h2>
      <p class="section-text reveal rv2" data-i18n="about_p1">{es.about_p1}</p>
      <p class="section-text reveal rv3" data-i18n="about_p2">{es.about_p2}</p>
      <div class="about-pillars">
        <div class="pillar reveal rv2">
          <div class="pillar-title" data-i18n="p1_title">{es.p1_title}</div>
          <div class="pillar-text" data-i18n="p1_text">{es.p1_text}</div>
        </div>
        <div class="pillar reveal rv3">
          <div class="pillar-title" data-i18n="p2_title">{es.p2_title}</div>
          <div class="pillar-text" data-i18n="p2_text">{es.p2_text}</div>
        </div>
        <div class="pillar reveal rv3">
          <div class="pillar-title" data-i18n="p3_title">{es.p3_title}</div>
          <div class="pillar-text" data-i18n="p3_text">{es.p3_text}</div>
        </div>
        <div class="pillar reveal rv4">
          <div class="pillar-title" data-i18n="p4_title">{es.p4_title}</div>
          <div class="pillar-text" data-i18n="p4_text">{es.p4_text}</div>
        </div>
      </div>
    </div>
    <div class="about-visual">
      <div class="about-img-wrap">
        <img src={site.about_image_url} alt={site.about_image_alt} loading="lazy" onerror="this.parentElement.style.background='#1a4f75'">
        <div class="about-img-overlay"></div>
        <div class="about-img-stat">
          <div class="stat-item">
            <div class="stat-num">{site.stat_countries}</div>
            <div class="stat-label" data-i18n="stat1">{es.stat1}</div>
          </div>
          <div class="stat-item">
            <div class="stat-num">{site.stat_languages}</div>
            <div class="stat-label" data-i18n="stat2">{es.stat2}</div>
          </div>
          <div class="stat-item">
            <div class="stat-num">{site.stat_ideas}</div>
            <div class="stat-label" data-i18n="stat3">{es.stat3}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AREAS -->
<section class="areas" id="areas">
  <div class="areas-inner">
    <div class="areas-header">
      <div class="section-eyebrow reveal" data-i18n="areas_eyebrow">{es.areas_eyebrow}</div>
      <h2 class="section-title reveal rv1" data-i18n="areas_title">{es.areas_title}</h2>
    </div>
    <div class="areas-grid">
      <div class="area-card reveal">
        <div class="area-num">01</div>
        <div class="area-title" data-i18n="a1_title">{es.a1_title}</div>
        <div class="area-text"  data-i18n="a1_text">{es.a1_text}</div>
      </div>
      <div class="area-card reveal rv1">
        <div class="area-num">02</div>
        <div class="area-title" data-i18n="a2_title">{es.a2_title}</div>
        <div class="area-text"  data-i18n="a2_text">{es.a2_text}</div>
      </div>
      <div class="area-card reveal rv2">
        <div class="area-num">03</div>
        <div class="area-title" data-i18n="a3_title">{es.a3_title}</div>
        <div class="area-text"  data-i18n="a3_text">{es.a3_text}</div>
      </div>
      <div class="area-card reveal rv1">
        <div class="area-num">04</div>
        <div class="area-title" data-i18n="a4_title">{es.a4_title}</div>
        <div class="area-text"  data-i18n="a4_text">{es.a4_text}</div>
      </div>
      <div class="area-card reveal rv2">
        <div class="area-num">05</div>
        <div class="area-title" data-i18n="a5_title">{es.a5_title}</div>
        <div class="area-text"  data-i18n="a5_text">{es.a5_text}</div>
      </div>
      <div class="area-card reveal rv3">
        <div class="area-num">06</div>
        <div class="area-title" data-i18n="a6_title">{es.a6_title}</div>
        <div class="area-text"  data-i18n="a6_text">{es.a6_text}</div>
      </div>
    </div>
  </div>
</section>

<!-- COLABORA -->
<section class="collab" id="colabora">
  <div class="collab-bg"></div>
  <div class="collab-inner">
    <div class="collab-header">
      <div class="section-eyebrow reveal" data-i18n="collab_eyebrow">{es.collab_eyebrow}</div>
      <h2 class="section-title reveal rv1" data-i18n="collab_title">{es.collab_title}</h2>
      <p class="collab-lead reveal rv2" data-i18n="collab_lead">{es.collab_lead}</p>
    </div>
    <div class="collab-cards">

      <div class="collab-card reveal rv1">
        <div class="collab-card-tag" data-i18n="c1_tag">{es.c1_tag}</div>
        <div class="collab-card-icon">
          <svg viewBox="0 0 24 24"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="collab-card-title" data-i18n="c1_title">{es.c1_title}</div>
        <div class="collab-card-text"  data-i18n="c1_text">{es.c1_text}</div>
        <ul class="collab-card-features" data-i18n-list="c1_features">
          {es.c1_features.map(item => <li>{item}</li>)}
        </ul>
        <button class="btn-collab-primary" onclick="openModal('intelectual')">
          <span data-i18n="c1_btn">{es.c1_btn}</span> <span class="btn-arr">→</span>
        </button>
      </div>

      <div class="collab-card reveal rv2">
        <div class="collab-card-tag" data-i18n="c2_tag">{es.c2_tag}</div>
        <div class="collab-card-icon">
          <svg viewBox="0 0 24 24"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="collab-card-title" data-i18n="c2_title">{es.c2_title}</div>
        <div class="collab-card-text"  data-i18n="c2_text">{es.c2_text}</div>
        <ul class="collab-card-features" data-i18n-list="c2_features">
          {es.c2_features.map(item => <li>{item}</li>)}
        </ul>
        <button class="btn-collab-outline" onclick="openModal('apoyo')">
          <span data-i18n="c2_btn">{es.c2_btn}</span> <span class="btn-arr">→</span>
        </button>
      </div>

    </div>
    <div class="collab-note reveal rv2">
      <p>¿Tienes dudas sobre cómo colaborar? <a href="#contacto">Escríbenos directamente</a> o conéctate con nosotros en <a href={site.linkedin} target="_blank">LinkedIn</a>. <strong>Todas las solicitudes son revisadas manualmente por el equipo de PASS-A.</strong></p>
    </div>
  </div>
</section>

<!-- MODAL COLABORACIÓN INTELECTUAL -->
<div class="modal-ov" id="ov-intelectual" onclick="closeModal('intelectual')"></div>
<div class="modal-box" id="modal-intelectual" role="dialog" aria-modal="true">
  <div class="modal-header">
    <span class="modal-tag">Colaboración intelectual</span>
    <button class="modal-close" onclick="closeModal('intelectual')">✕</button>
  </div>
  <div class="modal-title">Aporta tu voz y conocimiento</div>
  <div class="modal-body">
    <form id="form-i" onsubmit="submitModal(event,'intelectual')">
      <div class="field-row">
        <div class="field-group"><label class="field-label">Nombre completo *</label><input required type="text" class="field-input" placeholder="Tu nombre completo"></div>
        <div class="field-group"><label class="field-label">Email *</label><input required type="email" class="field-input" placeholder="tu@email.com"></div>
      </div>
      <div class="field-row">
        <div class="field-group">
          <label class="field-label">Perfil profesional *</label>
          <select required class="field-input">
            <option value="">Selecciona tu perfil</option>
            <option>Académico / Investigador</option>
            <option>Profesional / Consultor</option>
            <option>Institución / Organización</option>
            <option>Otro</option>
          </select>
        </div>
        <div class="field-group">
          <label class="field-label">Área temática *</label>
          <select required class="field-input">
            <option value="">Selecciona un área</option>
            <option>Economía y finanzas</option>
            <option>Política y gobernanza</option>
            <option>Derecho y regulación</option>
            <option>Desarrollo sostenible</option>
            <option>Tecnología e innovación</option>
            <option>Relaciones internacionales</option>
            <option>Otra</option>
          </select>
        </div>
      </div>
      <div class="field-group"><label class="field-label">Presentación breve *</label><textarea required class="field-input" rows="4" placeholder="Cuéntanos quién eres, en qué te especializas y qué te motiva a colaborar con PASS-A…"></textarea></div>
      <div class="field-group" style="margin-bottom:28px;"><label class="field-label">LinkedIn / Web profesional</label><input type="url" class="field-input" placeholder="https://linkedin.com/in/…"></div>
      <button type="submit" class="modal-submit-primary">Enviar solicitud →</button>
    </form>
    <div class="modal-success" id="success-intelectual">
      <div class="modal-success-icon">✓</div>
      <h3>Solicitud enviada</h3>
      <p>Hemos recibido tu solicitud. El equipo de PASS-A la revisará y se pondrá en contacto contigo en breve.</p>
    </div>
  </div>
</div>

<!-- MODAL APOYO INSTITUCIONAL -->
<div class="modal-ov" id="ov-apoyo" onclick="closeModal('apoyo')"></div>
<div class="modal-box" id="modal-apoyo" role="dialog" aria-modal="true">
  <div class="modal-header">
    <span class="modal-tag">Apoyo institucional</span>
    <button class="modal-close" onclick="closeModal('apoyo')">✕</button>
  </div>
  <div class="modal-title">Apoya el proyecto</div>
  <div class="modal-body">
    <form id="form-a" onsubmit="submitModal(event,'apoyo')">
      <div class="field-row">
        <div class="field-group"><label class="field-label">Nombre / Entidad *</label><input required type="text" class="field-input" placeholder="Tu nombre o nombre de la entidad"></div>
        <div class="field-group"><label class="field-label">Email de contacto *</label><input required type="email" class="field-input" placeholder="contacto@entidad.com"></div>
      </div>
      <div class="field-group">
        <label class="field-label">Tipo de apoyo que te interesa</label>
        <div class="field-checkboxes">
          <label class="field-check-label"><input type="checkbox"> Donación puntual</label>
          <label class="field-check-label"><input type="checkbox"> Patrocinio de evento</label>
          <label class="field-check-label"><input type="checkbox"> Alianza estratégica</label>
          <label class="field-check-label"><input type="checkbox"> Suscripción institucional</label>
        </div>
      </div>
      <div class="field-group"><label class="field-label">Mensaje</label><textarea class="field-input" rows="3" placeholder="Cuéntanos más sobre tu interés en PASS-A…"></textarea></div>
      <div class="modal-notice">La pasarela de pagos estará activa próximamente. Por ahora, nos pondremos en contacto contigo para coordinar los detalles del apoyo.</div>
      <button type="submit" class="modal-submit-outline">Enviar mensaje →</button>
    </form>
    <div class="modal-success" id="success-apoyo">
      <div class="modal-success-icon">✓</div>
      <h3>Mensaje recibido</h3>
      <p>Gracias por tu interés en apoyar PASS-A. Nos pondremos en contacto contigo para coordinar los próximos pasos.</p>
    </div>
  </div>
</div>

<!-- CONTACT CTA -->
<section class="contact-cta" id="contacto">
  <div class="contact-cta-inner">
    <div class="contact-cta-text reveal">
      <div class="label" data-i18n="contact_label">{es.contact_label}</div>
